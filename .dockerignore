.github
*.log
.env
.env.*
!.env.example

node_modules
**/node_modules
apps/web
.next
bin

__pycache__
**/__pycache__
*.pyc
apps/ml/artifacts
apps/ml/benchmarks/.bench_cache
*.onnx

.gomodcache
.gocache
.minio-data
.home
.tmp
.pytest_cache
.ruff_cache

docs
loadtest
scripts
README.md
LICENSE
Makefile
docker-compose.yml
go.work
go.work.sum
