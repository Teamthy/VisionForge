# ──────────────────────────────────────────────────────────
# VisionForge — Shared Environment Configuration Template
# Copy to .env (for docker compose) or set in your shell.
# NEVER commit .env to Git.
# ──────────────────────────────────────────────────────────

# Global
ENVIRONMENT=development
LOG_LEVEL=debug
TZ=UTC

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=visionforge
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_DB=visionforge
DATABASE_URL=postgres://visionforge:change_me_in_dev@postgres:5432/visionforge?sslmode=disable

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ── Object Storage (MinIO / S3-compatible) ───────────────
STORAGE_BACKEND=minio           # minio | s3
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=visionforge
S3_SECRET_KEY=change_me_in_dev
S3_REGION=us-east-1
S3_BUCKET=visionforge
S3_FORCE_PATH_STYLE=true

# ── API (Go) ─────────────────────────────────────────────
API_PORT=8080
API_HOST=0.0.0.0
API_READ_TIMEOUT=30s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=120s
API_BASE_URL=http://localhost:8080
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT / Auth
JWT_SECRET=replace_with_long_random_string_min_32_bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12

# ── Worker (Go) ──────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL=1s
WORKER_MAX_ATTEMPTS=5
WORKER_DEAD_LEQUEUE_TTL=720h

# ── ML Service (Python) ──────────────────────────────────
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8090
ML_SERVICE_URL=http://ml:8090
ML_ARTIFACTS_DIR=/app/artifacts
ML_DEVICE=cpu
ML_MAX_IMAGE_DIMENSION=4096
ML_MAX_IMAGE_BYTES=20971520    # 20 MB
ML_MAX_INFERENCE_MS=60000

# ── Web (Next.js) ────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXTAUTH_SECRET=replace_with_long_random_string_min_32_bytes
NEXTAUTH_URL=http://localhost:3000

# ── Observability ────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
PROMETHEUS_ENABLED=true

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120
RATE_LIMIT_UPLOAD_PER_MIN=30

# ── File Limits ──────────────────────────────────────────
MAX_IMAGE_UPLOAD_BYTES=20971520    # 20 MB
MAX_VIDEO_UPLOAD_BYTES=209715200   # 200 MB
MAX_REQUEST_BODY_BYTES=262144000   # 250 MB
